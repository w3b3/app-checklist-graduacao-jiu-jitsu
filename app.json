{
  "expo": {
    "name": "BJJ Checklist",
    "slug": "bjj-checklist",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/withOrientation.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite o BJJ Checklist acessar suas fotos para documentar técnicas",
          "cameraPermission": "Permite o BJJ Checklist acessar sua câmera para tirar fotos de técnicas"
        }
      ],
      "expo-file-system",
      "expo-localization",
      "expo-screen-orientation"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brothersfight.bjjchecklist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "24"
    },
    "android": {
      "package": "com.brothersfight.bjjchecklist",
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7268852c-7783-485e-b623-d2c8ca352919"
      }
    }
  }
}
